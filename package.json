{
  "name": "dsh-chat-search",
  "version": "1.0.1",
  "description": "DSH 对话搜索插件：支持全局跨会话搜索与当前会话内精准搜索，快速定位上下文并高亮锁定",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "chat-search",
    "session",
    "search",
    "history"
  ],
  "author": "helo060228",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helo060228/dsh-chat-search.git"
  },
  "homepage": "https://github.com/helo060228/dsh-chat-search#readme",
  "bugs": {
    "url": "https://github.com/helo060228/dsh-chat-search/issues"
  },
  "dsh": {
    "minVersion": "0.2.1-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots", "sessions", "uiWorkspace", "uiConversation", "locale"]
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
